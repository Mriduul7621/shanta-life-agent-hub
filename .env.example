# Agent Hub — environment template. Copy to `.env` for local dev.
# NEVER commit a real `.env` with a production secret. The JWT secret here is
# DEV ONLY: it signs demo tokens on the developer's machine. Production uses a
# server-issued secret (see docs/SSO_TOKEN.md) — the Hub must never ship a
# signing secret in client code.

# Demo auth provider. "true" enables the 4 fictional demo users (9990001–9990004,
# PIN 123456). MUST be false/absent in any production build.
VITE_DEMO_AUTH=true

# DEV-ONLY HS256 signing secret for demo SSO tokens. Change it per developer
# machine; it has no value outside local demo sign-in.
VITE_JWT_SECRET=dev-only-change-me-hub-demo-secret

# Supabase Hub auth project (Milestone 2 wiring — not used in Milestone 1).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
