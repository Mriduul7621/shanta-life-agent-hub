# Agent Hub — environment template. Copy to `.env` for local dev.
# NEVER commit a real `.env` with a signing key. Production tokens are issued
# server-side (see docs/SSO_PRODUCTION.md) — the Hub must never ship a
# signing key in client code.

# Build target: dev | qa | production (DEFAULT production).
# - dev: local development (demo auth + local signing allowed).
# - qa: QA builds (`npm run qa` forces this itself).
# - production: the guard in vite.config.ts FAILS the build if
#   VITE_DEMO_AUTH=true or any VITE_JWT_* signing variable is set.
HUB_BUILD_TARGET=dev

# Demo auth provider. "true" enables the 4 fictional demo users (9990001–9990004,
# PIN 123456). OFF by default. MUST be false/absent in any production build.
VITE_DEMO_AUTH=false

# DEV-ONLY RS256 signing key (PKCS#8 DER, base64) for demo SSO tokens.
# Generate one with: node scripts/gen-dev-keys.mjs  (prints the value; it
# never writes .env). The matching PUBLIC key is committed in
# src/auth/keys.ts — the private key here must be its pair, or token
# verification fails. Production uses a server-side key, never this.
# VITE_JWT_PRIVATE_KEY_B64=<paste output of scripts/gen-dev-keys.mjs>

# Hub SSO public key override (QA / key-rotation testing only). The key is
# PUBLIC, so overriding it is safe — but it must match the private key
# above, and joined modules bundle their own copy. Leave unset to use the
# bundled dev key in src/auth/keys.ts.
# VITE_HUB_PUBLIC_KEY_PEM=
# VITE_HUB_KID=

# Module URL overrides (QA only): JSON map of module id → URL, e.g.
# {"premiumpulse":"http://127.0.0.1:PORT/stub-module.html"}.
# `npm run qa` sets this itself to point a tile at a local stub module.
# VITE_MODULE_URL_OVERRIDES=

# Supabase Hub auth project (Milestone 2 wiring — not used yet).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Retail Dashboard proxy (server-side only — set in Vercel, never in the
# client bundle). The /api/retail-data proxy verifies Hub JWTs with the
# PUBLIC key: HUB_PUBLIC_KEY_PEM / HUB_KID override the bundled dev key
# (api/_lib/verifyJwt.js, which must match src/auth/keys.ts). HUB_DEMO_FIXTURE
# serves the synthetic demo slice to fictional 999xxxx users — PREVIEW ONLY,
# never Production: the proxy also requires VERCEL_ENV !== 'production', and
# the vite.config.ts production build guard fails if this flag is on.
# HUB_DEMO_FIXTURE=true
# HUB_PUBLIC_KEY_PEM=
# HUB_KID=
