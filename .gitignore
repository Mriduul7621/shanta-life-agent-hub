# dependencies
node_modules/
# build output
dist/
dist-ssr/
*.local
# env files — NEVER commit real secrets
.env
.env.*.local
!.env.example
# logs
*.log
npm-debug.log*
# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
# local QA artefacts are kept (qa/), but never commit captures with real data

# tsc build info
*.tsbuildinfo

# Android — signing material must NEVER be committed (added before any
# keystore exists near this tree; the release keystore lives offline with
# its custodian + as base64 in GitHub Secrets, never in the repo)
*.jks
*.keystore
*.apk
*.aab
google-services.json
# Android build outputs + SDK-local files
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/
# The Gradle wrapper jar is a binary: CI installs Gradle via
# gradle/actions/setup-gradle instead (see .github/workflows/android.yml),
# so the jar is never committed. Local builds need Gradle 8.14.3 installed
# (or regenerate the wrapper with `gradle wrapper --gradle-version 8.14.3`).
android/gradle-wrapper.jar
# Generated by `npm run android:assets` (rasterized from
# public/icons/icon-maskable.svg) — regenerated in CI before every build
android/app/src/main/res/mipmap-*/ic_launcher*.png
# Copied by `npx cap sync android` (the minimal local error page) —
# regenerated on every sync, never committed
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
